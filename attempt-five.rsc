1b:["$","details",null,{"className":"five-detail","children":[["$","summary",null,{"children":"Where do The Witcher 4 and GTA VI fit?"}],["$","p",null,{"children":"They are future visual references outside the released-game benchmark set. Their promotional material cannot prove retail performance or comprehensive interaction. The source register records their status as checked on 4 September 2026 and must be refreshed before a later comparison."}],["$","a",null,{"href":"/alder/research/game-benchmarks.md","children":"Read the game research and source notes →"}]]}]
