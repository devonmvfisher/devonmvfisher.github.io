12:["$","section",null,{"className":"five-progress","children":[["$","span",null,{"className":"five-eyebrow","children":"WHERE WE ARE NOW"}],["$","h2",null,{"children":"A foundation, not a passing grade."}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]],"className":"lucide-check","size":18}],"Researched game references and two fixed rubrics"]}],["$","li",null,{"children":[["$","$Ld",null,{"ref":"$undefined","iconNode":"$12:props:children:2:props:children:0:props:children:0:props:iconNode","className":"lucide-check","size":18}],"Original worktable and pottery, with editable source files"]}],["$","li",null,{"children":[["$","$Ld",null,{"ref":"$undefined","iconNode":"$12:props:children:2:props:children:0:props:children:0:props:iconNode","className":"lucide-check","size":18}],"Separate simulation code and initial regression tests"]}]]}],["$","p",null,{"children":"The finished character, richer world, cloth and page handling, complete farming and repair loops, device checks and public handoff still have to earn their evidence. The first workroom is a development milestone."}],["$","video",null,{"className":"five-video","controls":true,"preload":"metadata","aria-label":"Attempt five development progress, subtitled, 36 seconds","children":["$","source",null,{"src":"/alder/attempt5-progress.mp4","type":"video/mp4"}]}],["$","p",null,{"className":"five-footnote","children":"36 seconds · subtitles only · normal-speed browser excerpts, followed by explicitly labelled Blender inspection stills. This shows development progress, not a finished-game or device-performance claim."}],["$","a",null,{"href":"/alder/attempt5-progress.mp4","download":true,"children":"Save the progress video →"}],["$","a",null,{"href":"/alder","children":"Explore the current milestone →"}]]}]
13:["$","section",null,{"className":"five-checkpoint","children":[["$","span",null,{"className":"five-eyebrow","children":"4 SEPTEMBER · PROVISIONAL EVIDENCE REVIEW"}],["$","h2",null,{"children":"How much has earned credit?"}],["$","div",null,{"children":[["$","p",null,{"children":[["$","b",null,{"children":"AA: 14.4 / 100"}],["$","span",null,{"children":"Target: 97, with every mandatory test passed."}]]}],["$","p",null,{"children":[["$","b",null,{"children":"AAA: 12.1 / 100"}],["$","span",null,{"children":"Target: 90, with every mandatory test passed."}]]}]]}],["$","p",null,{"children":[["$","strong",null,{"children":"No passing grade."}]," Of the 25 acceptance tests, 17 fail because required features are missing or incomplete; 8 remain untested. Narrow working demonstrations earn partial credit, while missing work stays in the total."]}],["$","p",null,{"children":"The biggest gaps are the character and mirror embodiment, direct cloth and pages, a playable garden, ceramic breakage, VR and real-device verification. This is a source-and-evidence review using the builder’s observations, not a blind playtest. The decimals come from the scoring arithmetic, not precise measurement of quality."}],["$","p",null,{"children":"These scores use a much larger, tougher contract than the earlier room grades. They cannot be compared directly with the original Astra room’s 89."}],["$","a",null,{"href":"/alder/research/checkpoint-assessment.md","children":"Read every score and its evidence →"}]]}]
14:["$","section",null,{"children":[["$","span",null,{"className":"five-eyebrow","children":"IDEAS FOR THE NEXT CHAPTER"}],["$","h2",null,{"children":"A home where you can make things."}],["$","p",null,{"children":"Later additions could include a music room, a production studio and an experimental workshop. The aim is equipment you can use: record a melody, save a project, edit a scene or test a mechanism."}],["$","details",null,{"className":"five-detail","children":[["$","summary",null,{"children":"Could the room contain a working computer or phone?"}],["$","p",null,{"children":"Yes, there are practical routes to investigate. Our own useful web apps could appear on a desk screen. A small Linux computer could use browser emulation. A modern Android phone could be streamed from a separate computer. Those are different systems, with different costs and limits."}],["$","p",null,{"children":"No emulator has been installed or connected yet. Typing must not accidentally move your character, and a tiny screen needs a readable enlarged view. The iPhone and headset tests still apply."}],["$","a",null,{"href":"/alder/research/in-world-computers.md","children":"Read the emulator options and test plan →"}]]}],["$","details",null,{"className":"five-detail","children":[["$","summary",null,{"children":"The studio and workshop plan"}],["$","p",null,{"children":"Original designs, working instruments and useful tools come first. These are future additions, not features already present in the cottage."}],["$","a",null,{"href":"/alder/research/FUTURE-EXPANSIONS.md","children":"Read the proposed studio systems →"}]]}],["$","details",null,{"className":"five-detail","children":[["$","summary",null,{"children":"Why the working title “Alder & Water”?"}],["$","p",null,{"children":"Other games already use “Slice of Life”. A preliminary search did not find an exact game-title match for “Alder & Water”, so it remains our working name. That search is not trademark or legal clearance."}],["$","a",null,{"href":"/alder/research/name-search.md","children":"Read the name search →"}]]}]]}]
15:["$","footer",null,{"children":[["$","p",null,{"children":"Build it carefully. Test it honestly. Keep the earlier evidence."}],["$","a",null,{"href":"/","children":"Return to the four-room collection ↑"}]]}]
