16:["$","p",null,{"children":"Seated drag and scroll, joystick movement, lamps, grabbing and page turning were exercised in the browser. Actual multitouch and headset handling remain unverified."}]
17:["$","div","Physical behaviour",{"children":[["$","h3",null,{"children":["Physical behaviour",["$","b",null,{"children":[10,"/",20]}]]}],["$","p",null,{"children":"Objects have weight and collision; the throw and pages bend. Paper contacts and fabric friction are approximations. There is no full fabric-to-object force exchange."}]]}]
18:["$","div","Performance & stability",{"children":[["$","h3",null,{"children":["Performance & stability",["$","b",null,{"children":[9,"/",15]}]]}],["$","p",null,{"children":"Contact calculations were optimized after a slowdown. Short desktop samples are not a sustained phone or headset performance test."}]]}]
